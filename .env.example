# Copy to .env.local for local development. See docs/demo-mode.md.

# Backend API gateway base URL (no trailing slash, no /api/v1)
ZURI_API_BASE_URL=http://localhost:8080

# Demo login (backend-free). Set ZURI_DEMO_MODE=true to enable.
# Secret must be at least 32 characters: openssl rand -base64 48
ZURI_DEMO_MODE=false
ZURI_DEMO_SECRET=
